# Root Environment Variables Example for RecoverAI

# --- Backend Configuration ---
PORT=8080
DB_URL=jdbc:postgresql://localhost:5432/recoverai
DB_USERNAME=postgres
DB_PASSWORD=your_postgres_password_here
FLYWAY_ENABLED=true
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# --- Frontend Configuration ---
VITE_API_BASE_URL=http://localhost:8080/api

# --- Spring AI Configuration ---
SPRING_AI_OPENAI_API_KEY=
SPRING_AI_OPENAI_BASE_URL=https://openrouter.ai/api
SPRING_AI_OPENAI_MODEL=openrouter/free

# --- SMTP Mail Configuration (For Live Email Delivery) ---
SPRING_MAIL_HOST=smtp.gmail.com
SPRING_MAIL_PORT=587
SPRING_MAIL_USERNAME=
SPRING_MAIL_PASSWORD=
SPRING_MAIL_SMTP_AUTH=true
SPRING_MAIL_SMTP_STARTTLS_ENABLE=true
