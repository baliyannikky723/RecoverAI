# ==========================================
# RecoverAI Backend Environment Variables
# ==========================================

# Server Configuration
PORT=8080

# Database (PostgreSQL)
SPRING_DATASOURCE_URL=jdbc:postgresql://localhost:5432/recoverai
SPRING_DATASOURCE_USERNAME=postgres
SPRING_DATASOURCE_PASSWORD=postgres
FLYWAY_ENABLED=true

# CORS Configuration (Comma-separated allowed origins)
CORS_ALLOWED_ORIGINS=http://localhost:5173,http://localhost:3000,http://localhost:4173

# Demo Data Seeder (true/false)
APP_SEED_ENABLED=true
